{
  "name": "@atest/cli",
  "version": "0.1.0",
  "description": "The atest binary: flaky analysis, healing, impact, reporting, and diagnostics",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "atest": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@atest/core": "^0.1.0",
    "@atest/flaky": "^0.1.0",
    "@atest/heal": "^0.1.0",
    "@atest/impact": "^0.1.0",
    "@atest/llm": "^0.1.0",
    "@atest/agent": "^0.1.0",
    "@atest/report": "^0.1.0",
    "@atest/author": "^0.1.0"
  },
  "peerDependencies": {
    "@atest/store-azure": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@atest/store-azure": {
      "optional": true
