{
  "name": "@aplaytest/cli",
  "version": "0.1.0",
  "description": "The aplaytest binary: flaky analysis, healing, impact, reporting, and diagnostics",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aplaytest": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@aplaytest/core": "^0.1.0",
    "@aplaytest/flaky": "^0.1.0",
    "@aplaytest/heal": "^0.1.0",
    "@aplaytest/impact": "^0.1.0",
    "@aplaytest/llm": "^0.1.0",
    "@aplaytest/agent": "^0.1.0",
    "@aplaytest/report": "^0.1.0",
    "@aplaytest/author": "^0.1.0"
  },
  "peerDependencies": {
    "@aplaytest/store-azure": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@aplaytest/store-azure": {
      "optional": true
