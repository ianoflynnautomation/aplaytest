{
  "name": "@atest/core",
  "version": "0.1.0",
  "description": "Core types, failure taxonomy, and configuration for atest. No Playwright, no network, no LLM.",
  "license": "MIT",
  "type": "module",
  "main": "./dist-cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js"
    }
  },
  "files": [
    "dist",
    "dist-cjs"
  ],
  "scripts": {
    "build": "tsc --build",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ianoflynnautomation/atest.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ianoflynnautomation/atest#readme",
  "bugs": {
    "url": "https://github.com/ianoflynnautomation/atest/issues"
  }
