# Copy to `.env` (never committed) and fill in what you use.
# Unset variables degrade scope, never correctness: CI still runs in `strict`
# mode with no model and no cloud history.

# ── Kill switch ──────────────────────────────────────────────────────────────
# Set to 0 to disable the Playwright reporter completely. Removing the reporter
# line from playwright.config.ts has the same effect.
# ATEST=0

# ── Run identity ─────────────────────────────────────────────────────────────
# Optional. The reporter uses this as the run id so shards of one workflow
# merge instead of overwriting each other. GitHub Actions usually provides
# GITHUB_SHA / GITHUB_REF_NAME already.
# ATEST_RUN_ID=ci-123
# APP_ENV=staging
# BASE_URL=http://localhost:8080
# GITHUB_SHA=
# GITHUB_REF_NAME=

# ── History store ────────────────────────────────────────────────────────────
# A path is a local SQLite file. `azblob://<account>/<container>[/<prefix>]`
# is Azure Blob Storage. `:memory:` is a throwaway (not for CI — flake scoring
# will report "insufficient data" forever).
# Add `?readonly=1` to score without writing, `?window=<days>` to bound reads.
# ATEST_HISTORY_URL=.atest/history.sqlite
# ATEST_HISTORY_URL=azblob://myaccount/atest-history?readonly=1
#
# Emulator only (Azurite). Production accounts disable shared keys.
# AZURE_STORAGE_KEY=
# ATEST_BLOB_ENDPOINT_SUFFIX=core.windows.net

# ── Azure identity (blob history in CI) ──────────────────────────────────────
# Used by DefaultAzureCredential. Prefer OIDC federation over a client secret.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_SUBSCRIPTION_ID=
# AZURE_FEDERATED_TOKEN_FILE=

# ── Model tier (optional) ────────────────────────────────────────────────────
# Required only for `atest agent author` and for ranking heal candidates.
# Flaky scoring, impact selection, reporting, and Tier-0 healing work without it.
# ANTHROPIC_API_KEY=

# ── MCP server ───────────────────────────────────────────────────────────────
# Mutating tools (apply heal, quarantine, gate) need BOTH of:
#   1. ATEST_MCP_WRITE=1
#   2. confirm: true on the tool call
# Unset = read-only.
# ATEST_MCP_WRITE=0
# ATEST_CWD=
# ATEST_EVIDENCE_DIR=.atest/evidence
# ATEST_RUNS_DIR=.atest/runs

# ── CLI ──────────────────────────────────────────────────────────────────────
# ATEST_DEBUG=1 prints a stack on internal errors (exit 5).
# NO_COLOR=1 disables ANSI colour even on a TTY.
# ATEST_DEBUG=0
# NO_COLOR=
